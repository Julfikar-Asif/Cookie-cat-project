-- Optional calculated tables for a cleaner Power BI model.

DimSegment =
DATATABLE(
    "Segment", STRING,
    "SegmentOrder", INTEGER,
    {
        {"0 rounds", 1},
        {"1-10", 2},
        {"11-50", 3},
        {"51-200", 4},
        {"200+", 5}
    }
)

DimVersion =
DATATABLE(
    "version", STRING,
    {
        {"gate_30"},
        {"gate_40"}
    }
)
